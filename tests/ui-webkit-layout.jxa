ObjC.import('Cocoa');
ObjC.import('WebKit');

const root = ObjC.unwrap($.NSFileManager.defaultManager.currentDirectoryPath);
function read(path) {
  return ObjC.unwrap($.NSString.stringWithContentsOfFileEncodingError(root + '/' + path, $.NSUTF8StringEncoding, null));
}
// Evaluate only repository-owned markup/glyphs, never the app backend or app JS.
const source = read('src/main.ts');
const template = source.split("document.querySelector('#app')!.innerHTML = `")[1].split('`;\nconst el')[0];
const glyphText = source.split('const glyphs: Record<string,string> = ')[1].split(';\nconst icon')[0];
const glyphs = Function('return (' + glyphText + ')')();
const icon = name => '<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">' + glyphs[name] + '</svg>';
const html = Function('logo', 'icon', 'repositoryUrl', 'return `' + template + '`')('', icon, 'https://github.com/suhaasbadada/handsfree');
const css = read('src/style.css') + read('src/typography.css');
const app = $.NSApplication.sharedApplication;
app.setActivationPolicy($.NSApplicationActivationPolicyProhibited);
const config = $.WKWebViewConfiguration.new;
config.websiteDataStore = $.WKWebsiteDataStore.nonPersistentDataStore;
const web = $.WKWebView.alloc.initWithFrameConfiguration($.NSMakeRect(0, 0, 980, 820), config);
web.loadHTMLStringBaseURL('<!doctype html><html><head><meta name="viewport" content="width=device-width,initial-scale=1"><style>' + css + '</style></head><body><div id="app">' + html + '</div></body></html>', $.NSURL.URLWithString('about:blank'));
const deadline = Date.now() + 45000;
function tick() {
  $.NSRunLoop.currentRunLoop.runUntilDate($.NSDate.dateWithTimeIntervalSinceNow(0.01));
}
function evaluate(js) {
  let done = false, result = null, error = null;
  web.evaluateJavaScriptCompletionHandler(js, (value, failure) => {
    if (value) result = ObjC.unwrap(value);
    if (failure) error = ObjC.unwrap(failure.localizedDescription);
    done = true;
  });
  while (!done && Date.now() < deadline) tick();
  if (!done) throw Error('Bounded WKWebView deadline exceeded');
  if (error) throw Error(error);
  return result;
}
let ready = false;
while (!ready && Date.now() < deadline) {
  ready = Boolean(evaluate('Boolean(document.getElementById("settings"))'));
  if (!ready) tick();
}
if (!ready) throw Error('WKWebView fixture did not load');
evaluate(`
  document.getElementById('home').hidden = true;
  for (const id of ['settings','workflow','microphone-choice-row','health-input']) document.getElementById(id).hidden = false;
  document.querySelector('.setup-card').hidden = true;
  document.getElementById('saved-shortcut').textContent = 'Fn';
  for(const select of document.querySelectorAll('select')) {
    const wrapper=document.createElement('span');wrapper.className='select-wrap';
    const label=document.createElement('span');label.className='select-label';label.setAttribute('aria-hidden','true');label.textContent=select.selectedOptions[0]?.textContent||'';
    select.before(wrapper);wrapper.append(label,select);wrapper.insertAdjacentHTML('beforeend',${JSON.stringify(icon('chevron'))});
  }
  document.head.appendChild(Object.assign(document.createElement('style'), {id:'probe-mode'}));
  window.measure = () => {
    const metric = element => {
      const style = getComputedStyle(element);
      return {client:element.clientWidth,scroll:element.scrollWidth,box:element.offsetWidth,
        gutter:element.offsetWidth-element.clientWidth-parseFloat(style.borderLeftWidth||0)-parseFloat(style.borderRightWidth||0)};
    };
    const main = document.querySelector('main');
    return {viewport:[innerWidth,innerHeight],doc:metric(document.documentElement),main:metric(main),
      dialog:metric(document.getElementById('health-dialog')),healthInput:metric(document.getElementById('health-input')),
      controls:metric(document.querySelector('.microphone-controls')),mainOverflow:getComputedStyle(main).overflowX,
      selectOverflow:getComputedStyle(document.getElementById('microphone-choice')).overflow,
      chevrons:['recording-mode','sound-style'].every(id=>{
        const e=document.getElementById(id),c=e.parentElement.querySelector('svg'),s=getComputedStyle(c),r=e.getBoundingClientRect(),a=c.getBoundingClientRect(),canvas=document.createElement('canvas').getContext('2d');
        canvas.font=getComputedStyle(e).font;
        const gap=r.width-canvas.measureText(e.selectedOptions[0].textContent).width;
        return e.tagName==='SELECT' && a.width>=12 && s.display!=='none' && s.pointerEvents==='none' && s.color===getComputedStyle(document.body).color && Math.abs(a.top+a.height/2-r.top-r.height/2)<1 && gap>=24 && gap<=42;
      }),
      refreshFits:[['microphone-choice','microphone-refresh'],['health-microphone','health-microphone-refresh']].every(pair=>{
        const s=document.getElementById(pair[0]).getBoundingClientRect(),b=document.getElementById(pair[1]).getBoundingClientRect();
        return b.width===32 && s.right<=b.left && b.right<=innerWidth && b.left>=0;
      })};
  }; true
`);
const sizes = [[980,820],[980,600],[560,650],[320,650]];
const labels = ['System default · MacBook Air Microphone','Saved microphone · Unavailable','Extremely long running application option '.repeat(12)];
const forcedCSS = 'main,dialog{overflow-y:scroll;scrollbar-width:auto}main::-webkit-scrollbar,dialog::-webkit-scrollbar{display:block;width:16px;height:16px}';
function configure(size, theme, mode, label) {
  web.setFrameSize($.NSMakeSize(size[0], size[1]));
  evaluate(`
    document.documentElement.dataset.appearance=${JSON.stringify(theme)};
    document.getElementById('probe-mode').textContent=${JSON.stringify(mode==='native'?'':forcedCSS)};
    for (const id of ['microphone-choice','health-microphone','excluded-app-choice']) {
      const select=document.getElementById(id);
      select.replaceChildren(new Option(${JSON.stringify(label)},'a'),new Option('Second option','b'));
      select.parentElement.querySelector('.select-label').textContent=select.selectedOptions[0].textContent;
      select.disabled=false;
    }
    document.getElementById('health-dialog').showModal(); true
  `);
}
function fits(result) {
  return result.chevrons && result.refreshFits && ['doc','main','dialog','healthInput'].every(key=>result[key].scroll<=result[key].client);
}
let failures = 0, cases = 0;
for (const size of sizes)
for (const theme of ['light','dark'])
for (const mode of ['native','forced-css-scrollbars'])
for (const label of labels) {
  configure(size,theme,mode,label);
  const result=JSON.parse(evaluate('JSON.stringify(measure())'));
  const guttersOK=mode==='native'||(result.main.gutter===16&&result.dialog.gutter===16);
  const ok=fits(result)&&guttersOK;
  cases++; if(!ok) failures++;
  console.log(JSON.stringify({size,theme,mode,label:label.length>80?'extreme-long':label,ok,...result}));
  evaluate("document.getElementById('health-dialog').close(); true");
}
// Reversibly restore the legacy in-flow native select and remove containment.
// The overlay/mirror layout also prevents this leak, so removing only overflow
// is no longer a faithful reproduction of the old WebKit layout.
configure([980,600],'light','native',labels[2]);
const fixed=JSON.parse(evaluate('JSON.stringify(measure())'));
const broken=JSON.parse(evaluate("for(const select of document.querySelectorAll('select')){select.style.overflow='visible';select.style.position='static';select.parentElement.querySelector('.select-label').style.display='none';}JSON.stringify(measure())"));
const restored=JSON.parse(evaluate("for(const select of document.querySelectorAll('select')){select.style.overflow='';select.style.position='';select.parentElement.querySelector('.select-label').style.display='';}JSON.stringify(measure())"));
console.log('NEGATIVE_CONTROL='+JSON.stringify({fixed,broken,restored}));
evaluate("document.getElementById('health-dialog').close(); true");
if(!fits(fixed)||!fits(restored))throw Error('Fixed/restored fixture overflows');
if(broken.main.scroll<=broken.main.client)throw Error('Negative control did not reproduce inner overflow');
if(broken.doc.scroll>broken.doc.client)throw Error('Negative control unexpectedly overflowed document');
console.log('CASES='+cases);
console.log('FAILURES='+failures);
if(cases!==48||failures!==0)throw Error('WKWebView layout regression');

// Issue #1: execute actual WebKit text layout, not only control outer bounds.
let homeCases=0,homeFailures=0;
for(const size of [[980,820],[560,650],[320,650]])
for(const theme of ['light','dark'])
for(const phase of ['complete','empty'])
for(const fontSize of [14,28]) {
  web.setFrameSize($.NSMakeSize(size[0],size[1]));
  const result=JSON.parse(evaluate(`
    document.documentElement.dataset.appearance=${JSON.stringify(theme)};
    document.getElementById('probe-mode').textContent='';
    document.getElementById('settings').hidden=true;
    document.getElementById('home').hidden=false;
    document.getElementById('practice').hidden=false;
    document.getElementById('practice-start').disabled=false;
    document.getElementById('practice-start').hidden=false;
    document.getElementById('practice-start').querySelector('span').textContent='Record again';
    document.getElementById('practice-start').querySelector('span').style.fontSize='${fontSize}px';
    document.getElementById('practice-message').textContent=${JSON.stringify(phase==='complete'?'Practice complete. Nothing was pasted or saved. Clear to try again.':'No speech detected. Clear and try again.')};
    (()=>{const b=document.getElementById('practice-start'),r=b.getBoundingClientRect(),s=getComputedStyle(b),range=document.createRange();range.selectNodeContents(b.querySelector('span'));const rects=[...range.getClientRects(),b.querySelector('svg').getBoundingClientRect()],p={l:parseFloat(s.paddingLeft)+parseFloat(s.borderLeftWidth),r:parseFloat(s.paddingRight)+parseFloat(s.borderRightWidth),t:parseFloat(s.paddingTop)+parseFloat(s.borderTopWidth),b:parseFloat(s.paddingBottom)+parseFloat(s.borderBottomWidth)};return JSON.stringify({fits:rects.every(c=>c.left>=r.left+p.l-1&&c.right<=r.right-p.r+1&&c.top>=r.top+p.t-1&&c.bottom<=r.bottom-p.b+1),contained:r.left>=0&&r.right<=innerWidth&&document.documentElement.scrollWidth<=innerWidth,button:[r.width,r.height]});})()
  `));
  const ok=result.fits&&result.contained;homeCases++;if(!ok)homeFailures++;
  console.log('HOME='+JSON.stringify({size,theme,phase,fontSize,ok,...result}));
}
console.log('HOME_CASES='+homeCases);
console.log('HOME_FAILURES='+homeFailures);
if(homeCases!==24||homeFailures!==0)throw Error('WKWebView completed Practice label regression');

// Native layout must keep the compact icon slot and normal gaps in both states.
for (const [width,height] of [[980,820],[560,650],[480,650],[320,650]]) {
  web.setFrameSize($.NSMakeSize(width,height));
  const result = JSON.parse(evaluate(`(() => {
    const button = document.getElementById('updates-open');
    const label = document.getElementById('updates-indicator-label');
    const detail = document.getElementById('updates-indicator-detail');
    const summary = label.parentElement;
    const footer = document.querySelector('footer');
    const bounds = () => [footer.getBoundingClientRect().top, footer.offsetHeight, document.querySelector('main').offsetHeight,
      ...['.footer-privacy','#repository-link','#app-version','#updates-open'].map(selector => {
        const rect = document.querySelector(selector).getBoundingClientRect();
        return [rect.left, rect.top, rect.width, rect.height];
      })];
    button.hidden = document.getElementById('repository-link').hidden = false;
    button.dataset.attention = 'none';
    const idle = bounds();
    button.dataset.attention = 'available';
    button.querySelector('svg').innerHTML = ${JSON.stringify(glyphs.download)};
    label.textContent = 'Download & update';
    detail.textContent = '0.1.4';
    const header = document.querySelector('.product-header').getBoundingClientRect();
    const row = footer.getBoundingClientRect();
    const [repo, version, update] = ['#repository-link','#app-version','#updates-open'].map(selector => document.querySelector(selector).getBoundingClientRect());
    return JSON.stringify({idle, offer:bounds(), aligned: header.left === row.left && header.right === row.right,
      compact: version.left - repo.right === 8 && update.left - version.right === 8 && update.width === 32 && update.height === 32,
      iconOnly: summary.classList.contains('sr-only') && document.documentElement.scrollWidth <= innerWidth});
  })()`));
  if (String(result.idle) !== String(result.offer) || !result.aligned || !result.compact || !result.iconOnly) {
    throw Error('WKWebView footer moved or clipped at ' + width + ': ' + JSON.stringify(result));
  }
}
