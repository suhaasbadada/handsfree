{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HandsFree",
  "version": "0.1.1",
  "identifier": "com.handsfree.local",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://127.0.0.1:5173", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "macOSPrivateApi": true,
    "windows": [{ "label": "main", "title": "HandsFree", "width": 980, "height": 820, "minWidth": 560, "minHeight": 650, "visible": true, "theme": "Light", "backgroundColor": "#f7f6f3" }],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost",
      "devCsp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost ws://127.0.0.1:5173; img-src 'self' asset: http://asset.localhost"
    }
  },
  "bundle": { "active": true, "targets": ["app", "dmg"], "resources": { "native/assets/sounds/listening.wav": "sounds/listening.wav", "native/assets/sounds/ending.wav": "sounds/ending.wav" }, "macOS": { "minimumSystemVersion": "14.0", "infoPlist": "Info.plist", "entitlements": "Entitlements.plist", "signingIdentity": "-" }, "icon": ["icons/icon.png", "icons/icon.icns"] }
}
